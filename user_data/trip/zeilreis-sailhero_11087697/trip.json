{"id": 11087697, "user_id": 5263328, "name": "Zeilreis sailhero", "type": null, "visibility": 2, "live_location_visibility": 2, "start_location_visibility": 2, "map_style": null, "view_mode": null, "show_elevation_profile": false, "slug": "zeilreis-sailhero", "start_date": 1717884000.0, "end_date": 1718747999.0, "is_deleted": false, "open_graph_id": null, "fb_publish_status": null, "total_km": 1995.6165, "views": 135, "featured": null, "featured_priority_for_new_users": null, "feature_text": null, "feature_date": null, "language": null, "timezone_id": "Europe/Amsterdam", "summary": "10 daagjes lekker varen", "cover_photo_path": "https://polarsteps.s3.amazonaws.com/user_images/steps/large_thumb/u_5263328/62663B44-DCAA-4089-8C51-AE9355ACF52D_2B6BCCAD-1E29-48F8-B639-653A6DCA992A.jpg", "cover_photo_thumb_path": "https://polarsteps.s3.amazonaws.com/user_images/steps/small_thumb/u_5263328/62663B44-DCAA-4089-8C51-AE9355ACF52D_65360868-A59F-4913-8BC6-3E53910E4A82.jpg", "cover_photo": {"id": 8164274, "path": "https://polarsteps.s3.amazonaws.com/user_images/steps/full_res/u_5263328/62663B44-DCAA-4089-8C51-AE9355ACF52D_55E43CEA-7791-47CC-A81C-4AB628075EC4.jpg", "large_thumbnail_path": "https://polarsteps.s3.amazonaws.com/user_images/steps/large_thumb/u_5263328/62663B44-DCAA-4089-8C51-AE9355ACF52D_2B6BCCAD-1E29-48F8-B639-653A6DCA992A.jpg", "small_thumbnail_path": "https://polarsteps.s3.amazonaws.com/user_images/steps/small_thumb/u_5263328/62663B44-DCAA-4089-8C51-AE9355ACF52D_65360868-A59F-4913-8BC6-3E53910E4A82.jpg", "type": 0, "media_id": 789729696, "trip_id": 11087697, "full_res_unavailable": false, "last_modified": 1717935280.27021, "uuid": "D8841EC2-E033-47D7-BF42-2514AEA12940", "is_deleted": false, "synchronized": true}, "planned_steps_visible": true, "future_timeline_last_modified": null, "creation_time": 1713357401.963802, "step_count": 10, "travel_tracker_device": {"id": 5401553, "trip_id": 11087697, "device_name": null, "tracking_status": 0, "uuid": "c29afb33-e0e0-470d-8306-8d75f6ad312f", "last_modified": 1762213320.692722, "is_deleted": false, "synchronized": true}, "trip_buddies": [], "user": {"id": 5263328, "username": "Samgoestosea", "first_name": "Sam", "last_name": "\u3164", "creation_date": "2022-11-25T18:47:59.349054+00:00", "profile_image_path": "https://polarsteps.s3.amazonaws.com/user_images/profile/large_thumb/u_5263328/6e36c72b-fc92-404b-92a3-828d4b6af446_8b8f8813-ff11-43e1-9fc5-3b0c56096036.jpg", "profile_image_thumb_path": "https://polarsteps.s3.amazonaws.com/user_images/profile/small_thumb/u_5263328/6e36c72b-fc92-404b-92a3-828d4b6af446_7e7aba13-1963-4776-9694-a3961d9f0762.jpg", "uuid": "6e36c72b-fc92-404b-92a3-828d4b6af446", "subscription_type": null}, "uuid": "D80C7F6F-CB57-4F5F-8EBC-C41FB146B261", "last_modified": 1781096487.877768, "synchronized": true, "all_steps": [{"id": 105709947, "trip_id": 11087697, "location_id": 130683529, "main_media_item_path": null, "cover_media_id": null, "name": "Vertrek (dag 1)", "display_name": "Vertrek (dag 1)", "description": "Vandaag dan eindelijk vertrokken. \nWe zijn vertrokken met de bus vanuit Amsterdam Sloterdijk met z\u2019n tienen en twee begeleiders en daarna vertrokken naar Zwolle waar we de laatste twee hebben opgepikt.\nNadat we die twee hebben opgepikt zijn we doorgereden naar Kiel waar de boot ligt. \nHelaas duurde deze reis iets langer dan verwacht (11 uur lang \ud83d\udc80) vanwege heel erg veel file en een kapotte velg. \nMaar uiteindelijk zijn we dan toch nog aangekomen bij de boot en hebben we de bemanning/eigenaren Jans en lieve ontmoet. Hele aardige mensen.\nWe hebben op de boot lekker avond gegeten nog even een avond wandeling gemaakt/met elkaar beter kennis gemaakt, de dag met elkaar afgesloten en dan is de dag alweer voorbij. \n\nDag 1 overleefd.\n", "slug": "amsterdam", "display_slug": "amsterdam", "type": 1, "start_time": 1717912255.0, "end_time": null, "creation_time": 1717935197.454946, "location": {"id": 130683529, "name": "Amsterdam", "detail": "Netherlands", "full_detail": "North Holland, Netherlands", "country_code": "NL", "lat": 52.39204206424123, "lon": 4.839726319806118, "admin_area_code": null, "uuid": "C4BDB40F-41DF-4093-B812-165F6EABF26D", "last_modified": 0.0, "is_deleted": false, "synchronized": false}, "supertype": "normal", "is_deleted": false, "open_graph_id": null, "fb_publish_status": null, "timezone_id": "Europe/Amsterdam", "views": 0, "comment_count": 3, "weather_condition": "partly-cloudy-day", "weather_temperature": 16, "show_step_stats": false, "uuid": "604A22E7-91B6-4088-BB6D-A946CD795E90", "last_modified": 1718041478.462113, "synchronized": true}, {"id": 105824975, "trip_id": 11087697, "location_id": 130822050, "main_media_item_path": null, "cover_media_id": null, "name": "Dag 2", "display_name": "Dag 2", "description": "Vandaag was het dan zo ver. Tijd om uit te varen.\nVanochtend was ik lekker opgestaan en hebben we lekker ontbeten. We werken aan boord met een corvee schema en dat werd allemaal vanochtend uitgelegd. Ik had de middag corvee.\nRond een uurtje of 11 \u00e0 12 zijn we uitgevaren en hebben we heel de dag lekker doorgevaren tot ongeveer 20:45 waar we voor Denemarken ons anker \u2693\ufe0f hebben laten vallen.\nHeel de dag door hebben we hier en daar een beetje geholpen, maar het was over het algemeen wel een relaxte dag.\nNu nog even lekker chillen en daarna lekker slapen.\n\nDag 2 overleefd.", "slug": "kiel", "display_slug": "kiel", "type": 1, "start_time": 1718000355.303677, "end_time": null, "creation_time": 1718000567.791893, "location": {"id": 130822050, "name": "Kiel", "detail": "Germany", "full_detail": "Schleswig-Holstein, Germany", "country_code": "DE", "lat": 54.368887807868525, "lon": 10.151167735003066, "admin_area_code": null, "uuid": "3FF0EF0C-88F0-4276-A4F1-FB8474D09609", "last_modified": 0.0, "is_deleted": false, "synchronized": false}, "supertype": "normal", "is_deleted": false, "open_graph_id": null, "fb_publish_status": null, "timezone_id": "Europe/Berlin", "views": 0, "comment_count": 1, "weather_condition": "rain", "weather_temperature": 16, "show_step_stats": false, "uuid": "9D383EFD-CC2C-4313-BD52-E2A990DAABB3", "last_modified": 1718066735.131377, "synchronized": true}, {"id": 105981299, "trip_id": 11087697, "location_id": 131007642, "main_media_item_path": null, "cover_media_id": null, "name": "Dag 3", "display_name": "Dag 3", "description": "Vanochtend zijn we vertrokken vanuit ergens op zee.\nWe zijn vanochtend lekker weer opgestaan en hebben ontbeten terwijl het anker werd opgeheven. We zijn toen heel even een uurtje op de motor gaan varen waarna we lekker de zeilen hebben gehesen en lekker zijn gaan zeilen.\nRond een uurtje of 3 kwamen we aan in de haven van Middelfart in Denemarken \ud83c\udde9\ud83c\uddf0.\nDaar zijn we lekker de stad in geweest, hebben we \u2018s avonds lekker een spel met ze alle gespeeld en toen was het al weer tijd om te gaan slapen.\n\nDag 3 overleefd.", "slug": "assens", "display_slug": "assens", "type": 1, "start_time": 1718088355.0, "end_time": null, "creation_time": 1718089402.776181, "location": {"id": 131007642, "name": "Assens", "detail": "Denmark", "full_detail": "Southern, Denmark", "country_code": "DK", "lat": 55.14810561999998, "lon": 10.052936549999997, "admin_area_code": null, "uuid": "FA867750-F149-4E2F-9B05-C6956D620312", "last_modified": 0.0, "is_deleted": false, "synchronized": false}, "supertype": "normal", "is_deleted": false, "open_graph_id": null, "fb_publish_status": null, "timezone_id": "Europe/Copenhagen", "views": 0, "comment_count": 0, "weather_condition": "rain", "weather_temperature": 15, "show_step_stats": false, "uuid": "F1F965E2-6154-4548-950C-14E4766B54FE", "last_modified": 1718147902.803393, "synchronized": true}, {"id": 106108116, "trip_id": 11087697, "location_id": 131156828, "main_media_item_path": null, "cover_media_id": null, "name": "Dag 4", "display_name": "Dag 4", "description": "", "slug": "middelfart", "display_slug": "middelfart", "type": 1,