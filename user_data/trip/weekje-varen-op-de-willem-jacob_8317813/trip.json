ified": 0.0, "is_deleted": false, "synchronized": false}, "supertype": "normal", "is_deleted": false, "open_graph_id": null, "fb_publish_status": null, "timezone_id": "Europe/Amsterdam", "views": 0, "comment_count": 0, "weather_condition": "rain", "weather_temperature": 22, "show_step_stats": false, "uuid": "E165932A-F8C0-4A39-AC25-AEA620FB36FC", "last_modified": 1691860732.940751, "synchronized": true}, {"id": 72883627, "trip_id": 8317813, "location_id": 91851434, "main_media_item_path": null, "cover_media_id": null, "name": "Lauwersoog/Ameland ", "display_name": "Lauwersoog/Ameland ", "description": "Vandaag zijn we weer redelijk op tijd opgestaan omdat we weer een droogval tocht hadden. Ik was erg moe dus heb de hele tijd in me bed doorgebracht. Na het droogvallen moesten we redelijk haasten zodat ik de veerboot kon halen. Eenmaal aangekomen bij de veerpont waren we 1 minuut te laat en vertrok ie voor mijn neus. Omdat ik de veerpont heb gemist breng ik nog een avondje door op de Willem Jacob en pak ik morgen de veerboot van 8:30 en het openbaar vervoer naar huis.", "slug": "het-hogeland", "display_slug": "het-hogeland", "type": 1, "start_time": 1691795220.0, "end_time": null, "creation_time": 1691795223.843149, "location": {"id": 91851434, "name": "Nes", "detail": "Netherlands", "full_detail": "Friesland, Netherlands", "country_code": "NL", "lat": 53.448019699999996, "lon": 5.739406529999997, "admin_area_code": null, "uuid": "5B58C51E-8D1E-48C6-BBDD-CA9732098042", "last_modified": 0.0, "is_deleted": false, "synchronized": false}, "supertype": "normal", "is_deleted": false, "open_graph_id": null, "fb_publish_status": null, "timezone_id": "Europe/Amsterdam", "views": 0, "comment_count": 0, "weather_condition": "rain", "weather_temperature": 22, "show_step_stats": false, "uuid": "8C7A147C-9CE6-46F8-BFAF-9D529C3C8AB6", "last_modified": 1691908195.36982, "synchronized": true}, {"id": 73093524, "trip_id": 8317813, "location_id": 92093148, "main_media_item_path": null, 