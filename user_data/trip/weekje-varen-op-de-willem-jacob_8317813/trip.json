her_condition": "rain", "weather_temperature": 18, "show_step_stats": false, "uuid": "D5AA3AD0-90F3-4744-8F1E-DB3AC54B4848", "last_modified": 1691562916.94789, "synchronized": true}, {"id": 71939044, "trip_id": 8317813, "location_id": 91246093, "main_media_item_path": null, "cover_media_id": null, "name": "Ameland/terschelling", "display_name": "Ameland/terschelling", "description": "Vandaag zijn we van Ameland naar Terschelling gevaren. We hebben lekker laat ontbeten en zijn ons daarna klaar gaan maken voor de gasten. Tijdens de tocht hebben we heel even heel slecht weer gehad maar daarna werd het weer beter. Nadat we zijn aangekomen hebben we heerlijk avond gegeten en daarna nog even wat in de avond gedronken in de kroeg (ik geen alcohol hoor \ud83d\ude09. Daarna heb ik nog even een avondwandeling gemaakt waarna ik me bed ingedoken ben.", "slug": "west-terschelling", "display_slug": "west-terschelling", "type": 1, "start_time": 1691343874.600736, "end_time": null, "creation_time": 1691343879.33346, "location": {"id": 91246093, "name": "Ameland", "detail": "Netherlands", "full_detail": "Frisia, Netherlands", "country_code": "NL", "lat": 53.43682861328123, "lon": 5.776454452430613, "admin_area_code": null, "uuid": "41238DE2-6D0D-4326-BA7C-705A8766410D", "last_modified": 0.0, "is_deleted": false, "synchronized": false}, "supertype": "normal", "is_deleted": false, "open_graph_id": null, "fb_publish_status": null, "timezone_id": "Europe/Amsterdam", "views": 0, "comment_count": 1, "weather_condition": null, "weather_temperature": null, "show_step_stats": false, "uuid": "375E4CE6-6239-4B57-9FA7-DC7812E62CDF", "last_modified": 1691585369.414629, "synchronized": true}, {"id": 72127220, "trip_id": 8317813, "location_id": 91246161, "main_media_item_path": null, "cover_media_id": null, "name": "Terschelling/Vlieland/Terschelling", "display_name": "Terschelling/Vlieland/Terschelling", "description": "Vanochtend zijn we vroeg vertrokken richting Vlieland. We hadden onderweg redelijk hoge golven en lekkere harde wind. Toen we aankwamen in Ameland hebben we afscheid genomen van Chris die weer naar zijn eigen boot ging en hebben we lekker gelucht en ons klaargemaakt voor de rondvaart bij Vlieland. Tijdens de rondvaart hadden we nog hogere golven dan bij de heenweg wat echt heel gaaf was. Na de rondvaart hebben we lekker avond gegeten en zijn we teruggevaren naar Terschelling waar we nog even lekker geborreld hebben.", "slug": "west-terschelling", "display_slug": "west-terschelling", "type": 1, "start_time": 1691441584.794353, "end_time": null, "creation_time": 1691441868.845911, "location": {"id": 91246161, "name": "Midsland", "detail": "Netherlands", "full_detail": "Friesland, Netherlands", "country_code": "NL", "lat": 53.393880749999994, "lon": 5.285336589999986, "admin_area_code": null, "uuid": "2DBD384E-E8B5-4D41-8A20-B873F2AD5389", "last_modified": 0.0, "is_deleted": false, "synchronized": false}, "supertype": "normal", "is_deleted": false, "open_graph_id": null, "fb_publish_status": null, "timezone_id": "Europe/Amsterdam", "views": 0, "comment_count": 1, "weather_condition": null, "weather_temperature": null, "show_step_stats": false, "uuid": "CEA4FEE5-E5B0-4C22-81E2-EB73AF6295C8", "last_modified": 1691834575.05461, "synchronized": true}, {"id": 72356322, "trip_id": 8317813, "location_id": 91246194, "main_media_item_path": null, "cover_media_id": null, "name": "Terschelling/ameland", "display_name": "Terschelling/ameland", "description": "Vandaag zijn we van Terschelling naar Ameland gezeild. Het was gelukkig weer een beetje normaal weer maar het was wel heel koud op het water. ", "slug": "nes", "display_slug": "nes", "type": 1, "start_time": 1691475900.0, "end_time": null, "creation_time": 1691562782.284246, "location": {"id": 91246194, "name": "Nes", "detail": "Netherlands", "full_detail": "Friesland, Netherlands", "country_code": "NL", "lat": 53.448019699999996, "lon": 5.739406529999997, "admin_area_code": null, "uuid": "B55C06A3-AE